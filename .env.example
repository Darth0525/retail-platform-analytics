# .env.example
# -------------
# Copy this file to .env and fill in your Snowflake credentials.
# .env is gitignored and must never be committed.
#
# Usage:
#   cp .env.example .env
#   Then edit .env with your actual values

SNOWFLAKE_ACCOUNT=your_account.region.cloud        # e.g. dr92237.us-east-2.aws
SNOWFLAKE_USER=your_username
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/snowflake_rsa_key.p8
SNOWFLAKE_DATABASE=your_database                   # e.g. RETAIL_ANALYTICS
SNOWFLAKE_WAREHOUSE=your_warehouse                 # e.g. COMPUTE_WH
SNOWFLAKE_ROLE=your_role                           # e.g. ACCOUNTADMIN
